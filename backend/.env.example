# APP_ENV: dev | prod
APP_ENV=dev
PORT=4100
# Snapshot cache TTL (1h). The app's refresh button busts it on demand, so a long
# TTL is fine — it keeps the UI fast without re-querying the semantic layer often.
CACHE_TTL_MS=3600000

# ── Semantic layer (DataOS / Cube.js) — SSA Smart Claims data product ───────
# Only the data-product BASE url is configured here. Each request is
# authenticated with the signed-in user's OIDC access_token (forwarded by the
# frontend), so there is no service token in env.
SEMANTIC_API_URL=https://leidos-sandbox.instance.dataos.cloud/vulcan/tenants/onboarding/data-products/onboarding-ssa-claims-prod

SEMANTIC_CONCURRENCY=3
SEMANTIC_PAGE_SIZE=50000
SEMANTIC_POLL_TIMEOUT_MS=120000